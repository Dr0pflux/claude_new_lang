fn main() {
  let n = 10;                 // untyped constant
  let mut total: i64 = 0;     // 64-bit signed integer
  let small: u8 = 200;        // 8-bit unsigned
  let ratio: f64 = 0.75;      // double
  let ok = small > 100;       // bool
  total += n * small;         // u8 widens to i64 automatically
  print(total);               // 2000
  print(small as i8);         // -56: explicit conversion
  print(ratio * 4.0);         // 3.000000
  print(ok);                  // true
}
