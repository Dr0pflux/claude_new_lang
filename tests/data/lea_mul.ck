fn main() {
 let a = alloc<i64>(10);
 a[0] = 0;
 a[1] = 1;
 a[2] = -1;
 a[3] = 5;
 a[4] = -5;
 a[5] = 9223372036854775807;
 a[6] = -9223372036854775807;
 a[7] = 3074457345618258602;
 a[8] = -3074457345618258602;
 a[9] = argc() + 987654321;
 for i in 0..len(a) {
  let x = a[i];
  print(x * 3);
  print(x * 5);
  print(x * 9);
 }
}
